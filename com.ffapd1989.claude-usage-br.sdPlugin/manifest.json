{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "com.ffapd1989.claude-usage-br",
  "Name": "Uso Claude (variante BR)",
  "Version": "1.6.0.0",
  "Author": "ffapd1989 (fork de Saeed Kolivand)",
  "Description": "Variante BR do AI Coding Usage Meter: carrossel 5 horas ↔ Semanal com % grande e reset, além dos medidores originais. Funciona com Claude Code. Windows + macOS.",
  "URL": "https://github.com/ffapd1989/claude-usage-streamdeck-plugin",
  "Category": "Uso Claude (variante BR)",
  "CategoryIcon": "imgs/category-icon",
  "Icon": "imgs/plugin-icon",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "6.9"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    },
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "enabled"
  },
  "CodePath": "bin/plugin.js",
  "Actions": [
    {
      "Name": "Medidor de Uso",
      "UUID": "com.ffapd1989.claude-usage-br.meter",
      "Icon": "imgs/actions/meter/icon",
      "Tooltip": "Medidor de uso do Claude: carrossel 5 horas ↔ Semanal, limites ao vivo ou tokens/custo dos logs locais.",
      "PropertyInspectorPath": "ui/inspector.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/actions/meter/key",
          "TitleAlignment": "bottom"
        }
      ]
    }
  ]
}